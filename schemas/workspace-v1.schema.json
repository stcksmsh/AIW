{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State",
  "type": "object",
  "properties": {
    "active_plan": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_task": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Checkpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "plans": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Plan"
      }
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Task"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "plans",
    "tasks"
  ],
  "$defs": {
    "Checkpoint": {
      "type": "object",
      "properties": {
        "next_action": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "source_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "next_action",
        "note"
      ]
    },
    "CommandSpec": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "argv",
        "timeout_seconds"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "contract_hash": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunSummary"
          }
        },
        "source_hash": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_hash",
        "contract_hash",
        "success",
        "runs"
      ]
    },
    "Plan": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "objective"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "invariants"
      ]
    },
    "RunSummary": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "id": {
          "type": "string"
        },
        "omitted": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "tail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timed_out": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "argv",
        "success",
        "timed_out",
        "duration_ms",
        "stdout",
        "stderr",
        "diagnostics",
        "tail",
        "omitted"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "type": "string"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "title": {
          "type": "string"
        },
        "verify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandSpec"
          }
        },
        "worker": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "plan",
        "status",
        "dependencies",
        "scope",
        "acceptance",
        "constraints",
        "verify"
      ]
    }
  }
}
