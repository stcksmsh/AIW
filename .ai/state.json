{
  "schema_version": 1,
  "project": {
    "name": "AIW",
    "description": "Vendor-neutral persistent project state and deterministic tooling for disposable coding agents.",
    "invariants": [
      "Canonical AIW state is vendor-neutral; generated adapters never outrank it.",
      "No model calls, services or database are required for core operations.",
      "Completion requires fresh declared verification; logs stay outside default context.",
      "Recovery output is bounded and source changes invalidate old evidence."
    ]
  },
  "plans": {
    "v01": {
      "title": "AIW v0.1",
      "objective": "Prove durable vendor-neutral recovery with verified deterministic tooling"
    },
    "v02": {
      "title": "AIW v0.2 agent integration",
      "objective": "Make AIW automatically discoverable and enforce its durable lifecycle in Codex and Claude while keeping the CLI canonical"
    },
    "v1": {
      "title": "AIW v1 stable release",
      "objective": "Ship a documented, locally deterministic, interoperable and supportable AIW release with evidence from real recovery use"
    }
  },
